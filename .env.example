# Copy to .env and fill in the keys. .env is git- and docker-ignored.
#
#   docker run --env-file .env ...       # Quickstart
#   make local-up                        # docker compose reads .env itself
#   set -a; . ./.env; set +a             # go run, without Docker
#
# Keep values unquoted and comments on their own lines: docker --env-file
# takes everything after the = literally.
# The full list of settings is in the README's Configuration table.

# Model: anthropic, openai, ollama or bedrock.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://host.docker.internal:11434
# LLM_MODEL=

# Fact-check search: brave (live web) or kb (bundled knowledge base, no key).
SEARCH_PROVIDER=brave
BRAVE_API_KEY=

# Optional.
# TIMEOUT=10m
# WORKER_CONCURRENCY=2
# DEBUG=1
